# Copy to .env and fill in the required values: cp .env.example .env
# Optional settings are commented out and show their defaults (see src/config.ts).

# --- Required ---------------------------------------------------------------

# SpaceTraders agent token (from https://my.spacetraders.io or the register endpoint)
API_TOKEN=your-spacetraders-agent-token

# OpenAI-compatible chat completions endpoint (base URL, trailing slash is stripped)
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-llm-api-key
LLM_MODEL=your-model-name

# --- Optional: endpoints, storage, panel ------------------------------------

# ST_BASE_URL=https://api.spacetraders.io/v2
# LLM_TIMEOUT_MS=120000
# Set to 0 if your endpoint rejects the model's reasoning being sent back on earlier turns.
# LLM_ECHO_REASONING=1
# DATA_DIR=data
# Use 0.0.0.0 to listen on every interface (e.g. a homeserver reached over the LAN)
# PANEL_HOST=127.0.0.1
# Hostnames/IPs you open the panel by, besides localhost (comma-separated, "*" = any). No login: LAN use only.
# PANEL_ALLOWED_HOSTS=192.168.1.50,homeserver.lan
# PANEL_PORT=8787

# --- Optional: agent behaviour ----------------------------------------------

# "readonly" blocks every mutating tool; anything else means full control
# AGENT_POLICY=full
# Minimum action budget per wake; actual budget is max(this, AGENT_ACTIONS_PER_SHIP x fleet size)
# AGENT_MAX_ACTIONS_PER_WAKE=32
# AGENT_ACTIONS_PER_SHIP=6
# Credits ship purchases may not dip below
# AGENT_CREDIT_RESERVE=25000
# API requests spent at wake start reading markets/shipyards where ships sit (0 disables)
# AGENT_AUTO_SCAN_REQUESTS=8
# Background collector while the agent sleeps: maps systems, refreshes prices where ships are
# parked, reads jump gates and scouts connected systems (either set to 0 disables it)
# AGENT_COLLECTOR_INTERVAL_MS=120000
# AGENT_COLLECTOR_REQUESTS=6
# Minimum LLM rounds per wake; actual cap is max(this, AGENT_ROUNDS_PER_SHIP x fleet size)
# AGENT_MAX_ROUNDS_PER_WAKE=32
# AGENT_ROUNDS_PER_SHIP=4
# Extra LLM attempts after a timeout or server error; the wake keeps its conversation
# AGENT_LLM_RETRIES=3
# Top up fuel when a ship leaves a market that sells it (0 disables); skip markets priced more than
# this fraction above the cheapest fuel seen in the system unless the ship needs the fuel
# AGENT_AUTO_REFUEL=1
# AGENT_AUTO_REFUEL_MAX_PREMIUM=0.15
# Read the market (and a stale shipyard) wherever a ship arrives
# AGENT_READ_MARKET_ON_ARRIVAL=1
# Fulfil contracts when the last delivery lands and negotiate the next offer
# AGENT_AUTO_CONTRACTS=1
# Ship routines (trade/mine loops) never spend the balance below this on cargo
# AGENT_ROUTINE_MIN_CREDITS=5000
# AGENT_MAX_CONCURRENT_TOOLS=3
# Wake the agent after this long even if no ship event fires
# AGENT_FALLBACK_WAKE_MS=600000
# AGENT_MIN_WAKE_GAP_MS=60000

# --- Optional: SpaceTraders API transport -----------------------------------

# Minimum gap between API requests (SpaceTraders rate limit is ~2 req/s)
# TRANSPORT_MIN_INTERVAL_MS=600
# Retries for network errors and 5xx on reads
# TRANSPORT_MAX_RETRIES=2
# 429s are waited out (Retry-After) and resent up to this many times
# TRANSPORT_MAX_429_RETRIES=20
# TRANSPORT_TIMEOUT_MS=20000
# Cap on how long a single Retry-After wait may be
# TRANSPORT_MAX_RETRY_AFTER_MS=15000
