{
  "name": "space-trading-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "codegen": "python3 scripts/generate_api_types.py",
    "docs": "python3 scripts/generate_openapi_docs.py",
    "check:arch": "node scripts/check_architecture.mjs",
    "check:codegen": "python3 scripts/generate_api_types.py && git diff --exit-code -- src/generated",
    "typecheck": "tsc --noEmit",
    "test": "AGENT_MIN_WAKE_GAP_MS=500 tsx --env-file-if-exists=.env --test \"src/**/*.test.ts\"",
    "build": "tsc",
    "smoke": "tsx --env-file=.env src/smoke.ts",
    "start": "tsx watch --env-file=.env src/index.ts",
    "start:once": "tsx --env-file=.env src/index.ts",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "openai": "^7.22.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
